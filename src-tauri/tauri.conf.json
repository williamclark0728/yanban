{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Yanban",
  "mainBinaryName": "yanban",
  "version": "0.7.4",
  "identifier": "top.shengzy.yanban",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5180",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "研伴",
        "width": 1200,
        "height": 800,
        "minWidth": 380,
        "minHeight": 500,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg4Qjc0OUJEMzRFNzZBRjgKUldUNGF1YzB2VW0zaUlBaEc4QkFaQklRWFdFdCsrb01LR1d1L3BKVk5scjJmMCtNamNBT1RyRTYK",
      "endpoints": [
        "https://github.com/williamclark0728/yanban/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
